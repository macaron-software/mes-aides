// UniFFI interface definition for aides-core

namespace aides_core {
  SimulationResult simulate(Situation situation);
  sequence<AideInfo> list_aides();
  string translate(string lang, string key);
  sequence<string> supported_langs();
};

// ── Input ────────────────────────────────────────────────────────────────────

dictionary Situation {
  u8 age;
  string situation_familiale;
  u8 nb_enfants;
  sequence<u8> ages_enfants;
  string logement;
  double loyer_mensuel;
  string? code_postal;
  u8? zone_apl;
  double revenus_nets_mensuels;
  double revenus_conjoint;
  double patrimoine_estime;
  boolean ald;
  boolean rqth;
  boolean invalidite;
  boolean dependance;
  u8? gir;
  boolean cmu_c;
  string emploi;
  u32 anciennete_emploi_mois;
  double heures_semaine;
  boolean primo_accedant;
  boolean etudiant_boursier;
};

// ── Output ───────────────────────────────────────────────────────────────────

dictionary AideResult {
  string aide_id;
  boolean eligible;
  double? montant_mensuel;
  double? montant_annuel;
  double score;
  sequence<string> raisons;
  sequence<string> raisons_ineligible;
  u8 nb_etapes;
};

dictionary SimulationResult {
  sequence<AideResult> aides_eligibles;
  sequence<AideResult> aides_ineligibles;
  double total_mensuel;
  double total_annuel;
  string calcule_le;
  string version_baremes;
};

dictionary AideInfo {
  string id;
  string slug;
  string nom;
  string description;
  string categorie;
  double? montant_min;
  double? montant_max;
  string periodicite;
  string organisme;
  string url_info;
};
